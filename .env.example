# Application
APP_NAME=AI Property Agent
APP_ENV=development

# Local models (host processes use OLLAMA_BASE_URL)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_S=120

# Optional Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_REQUESTS_PER_MINUTE=10

# Docker Compose (copy to .env.compose and set a private password)
POSTGRES_DB=property_agent
POSTGRES_USER=property_agent
POSTGRES_PASSWORD=
COMPOSE_API_PORT=38000
COMPOSE_FRONTEND_PORT=38501
COMPOSE_N8N_PORT=35678
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Standalone outbox worker. Compose sets its URL using internal DNS.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
OUTBOX_HTTP_TIMEOUT=10
OUTBOX_POLL_INTERVAL=2
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=30

# Optional administration, enable explicitly in Sandbox
ADMIN_INGESTION_ENABLED=0
