{
  "name": "LeadCreated Internal Follow-up",
  "nodes": [
    {
      "name": "LeadCreated Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-created",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2f7a4ccf-adb6-4463-beb5-705262873820",
      "webhookId": "ddd73760-0a6b-4173-bd57-ca7bdd501c80"
    },
    {
      "name": "Validate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body;\nconst uuid = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/;\nconst valid = body && typeof body === 'object' && !Array.isArray(body)\n  && body.event_type === 'LeadCreated'\n  && typeof body.event_id === 'string' && body.event_id.length === 36 && uuid.test(body.event_id)\n  && typeof body.lead_id === 'string' && body.lead_id.length === 36 && uuid.test(body.lead_id)\n  && typeof body.property_id === 'string' && body.property_id.trim().length > 0\n  && body.property_id.length <= 20 && !/[\\u0000-\\u001f\\u007f]/.test(body.property_id);\nif (!valid) return { json: { valid: false, http_status: 400 } };\nconst { event_id, event_type, lead_id, property_id } = body;\nreturn { json: { valid: true, event_id, event_type, lead_id, property_id } };"
      },
      "id": "14abfae0-4956-48ae-9729-cea2b2feb107"
    },
    {
      "name": "Event Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ca60e0ce-9061-4389-8b92-4ded7ceff28e",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ab145d05-5ad8-4585-87fa-0d37a9ef9ec3"
    },
    {
      "name": "Persist or Verify Follow-up",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        -120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.process_lead_follow_up($1, $2, $3, $4) AS http_status, $1::text AS event_id;",
        "options": {
          "queryReplacement": "={{ [$json.event_id, $json.event_type, $json.lead_id, $json.property_id] }}"
        }
      },
      "id": "e4dd6f42-f94f-4625-b077-a8642e31e5c9",
      "onError": "continueErrorOutput"
    },
    {
      "name": "Reply Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        920,
        20
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.http_status === 200 ? {event_id: $json.event_id, accepted: true} : {accepted: false, error: ({400: 'invalid_event', 404: 'unknown_event', 409: 'event_conflict'})[$json.http_status] || 'database_unavailable'} }}",
        "options": {
          "responseCode": "={{ [200, 400, 404, 409].includes($json.http_status) ? $json.http_status : 503 }}"
        }
      },
      "id": "bd00a01b-c4b2-4eca-b79d-4d74a95346e1"
    },
    {
      "name": "Reply Database Unavailable",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        920,
        -180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"accepted\":false,\"error\":\"database_unavailable\"}",
        "options": {
          "responseCode": 503
        }
      },
      "id": "82ce32c5-52f0-4ee6-9ad0-f01db4fcd7ac"
    }
  ],
